; Driveable car. Built from the raw meshes rather than by instancing
; Prefabs/SM_PolygonCity_Veh_Car_Small_01.tscn, because that prefab carries a
; StaticBody3D per wheel plus a chassis MeshCollider that would fight this
; CharacterBody3D. Wheel offsets below match the prefab exactly.
;
; The meshes face +Z but Godot's forward is -Z, so Chassis and Wheels are yawed 180.

[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://Game/Units/Vehicle.gd" id="1_script"]
[ext_resource type="ArrayMesh" uid="uid://co7tw8r3n2dqu" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_01.res" id="2_body"]
; Mat_01..Mat_04 are palette swaps over identical UVs (Texture_01..04). Mat_01 is
; the blue set used by the plaza, so the car takes Mat_02 (red) to stand out --
; the same choice the pack's own Demo scene makes for its hero car. Swap this one
; line to recolour the whole vehicle.
[ext_resource type="Material" uid="uid://d1bnres68m4mj" path="res://Assets/Synty/PolygonStarter/Materials/PolygonStarter_Mat_02_mat.tres" id="3_mat"]
[ext_resource type="ArrayMesh" uid="uid://bvsog1kq1ugo0" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_Glass.res" id="4_glass"]
[ext_resource type="Material" uid="uid://bmnc0l3qv1jfs" path="res://Assets/Synty/PolygonStarter/Materials/Misc/PolygonStarter_Mat_01_Glass_mat.tres" id="5_glassmat"]
[ext_resource type="ArrayMesh" uid="uid://bdht7ik3xtbkk" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_Plates.res" id="6_plates"]
[ext_resource type="ArrayMesh" uid="uid://cendhe2iw5xj2" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_SteeringW.res" id="7_steer"]
[ext_resource type="ArrayMesh" uid="uid://cv61u0f33e277" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_Wheel_fl.res" id="8_fl"]
[ext_resource type="ArrayMesh" uid="uid://omj1hp4q2ygc" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_Wheel_fr.res" id="9_fr"]
[ext_resource type="ArrayMesh" uid="uid://52o8thqtnjgi" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_Wheel_rl.res" id="10_rl"]
[ext_resource type="ArrayMesh" uid="uid://dni68bu4odtmo" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonCity_Veh_Car_Small_Wheel_rr.res" id="11_rr"]

; Chassis AABB is 2.068 x 1.573 x 4.075 sitting on y=0; inset slightly so the car
; does not catch on scenery it visually clears. Bottom of the box is exactly y=0.
[sub_resource type="BoxShape3D" id="BoxShape3D_hull"]
size = Vector3(1.95, 1.73, 3.95)

; Selection ring lives on the unit rather than being a single shared node, so a
; multi-unit selection shows one ring each and every unit type can size its own.
; TorusMesh already lies flat in the XZ plane. Unshaded keeps it readable whatever
; the sun is doing.
[sub_resource type="TorusMesh" id="TorusMesh_ring"]
inner_radius = 1.75
outer_radius = 2.05
rings = 48
ring_segments = 8

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ring"]
transparency = 1
shading_mode = 0
albedo_color = Color(0.25, 1, 0.4, 0.85)

; Layer 1 is the static world, layer 2 the knockable props. The car collides with
; both (mask 3) but only treats layer 1 as ground: without that, driving over a cone
; makes the car inherit the struck rigid body's velocity and launches it off the map.
[node name="Car" type="CharacterBody3D"]
collision_mask = 3
platform_floor_layers = 1
script = ExtResource("1_script")
display_name = "Patrol Car"
selection_ring_path = NodePath("SelectionRing")

; Supplies path waypoints to the autopilot. Avoidance is off -- there is only one
; vehicle, and avoidance would fight the car's turning-circle constraints.
[node name="NavigationAgent" type="NavigationAgent3D" parent="."]
path_desired_distance = 2.0
target_desired_distance = 2.2
avoidance_enabled = false

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.865, -0.12)
shape = SubResource("BoxShape3D_hull")

[node name="SelectionRing" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.06, 0)
material_override = SubResource("StandardMaterial3D_ring")
cast_shadow = 0
mesh = SubResource("TorusMesh_ring")

[node name="Lean" type="Node3D" parent="."]

[node name="Chassis" type="Node3D" parent="Lean"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

[node name="Body" type="MeshInstance3D" parent="Lean/Chassis"]
gi_mode = 2
mesh = ExtResource("2_body")
surface_material_override/0 = ExtResource("3_mat")

[node name="Glass" type="MeshInstance3D" parent="Lean/Chassis"]
cast_shadow = 0
gi_mode = 2
mesh = ExtResource("4_glass")
surface_material_override/0 = ExtResource("5_glassmat")

[node name="Plates" type="MeshInstance3D" parent="Lean/Chassis"]
gi_mode = 2
mesh = ExtResource("6_plates")
surface_material_override/0 = ExtResource("3_mat")

[node name="SteeringWheel" type="MeshInstance3D" parent="Lean/Chassis"]
transform = Transform3D(1, 0, 0, 0, 0.34767452, 0.9376153, 0, -0.9376153, 0.34767452, 0.3792947, 0.9506907, 0.5220333)
gi_mode = 2
mesh = ExtResource("7_steer")
surface_material_override/0 = ExtResource("3_mat")

; Outside Lean so the wheels stay planted while the body rolls.
[node name="Wheels" type="Node3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

[node name="FL" type="Node3D" parent="Wheels"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.68201447, 0.3328057, 1.335427)

[node name="Mesh" type="MeshInstance3D" parent="Wheels/FL"]
gi_mode = 2
mesh = ExtResource("8_fl")
surface_material_override/0 = ExtResource("3_mat")

[node name="FR" type="Node3D" parent="Wheels"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.68201447, 0.3328057, 1.335427)

[node name="Mesh" type="MeshInstance3D" parent="Wheels/FR"]
gi_mode = 2
mesh = ExtResource("9_fr")
surface_material_override/0 = ExtResource("3_mat")

[node name="RL" type="Node3D" parent="Wheels"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.68201447, 0.3328057, -1.2131475)

[node name="Mesh" type="MeshInstance3D" parent="Wheels/RL"]
gi_mode = 2
mesh = ExtResource("10_rl")
surface_material_override/0 = ExtResource("3_mat")

[node name="RR" type="Node3D" parent="Wheels"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.68201447, 0.3328057, -1.2131475)

[node name="Mesh" type="MeshInstance3D" parent="Wheels/RR"]
gi_mode = 2
mesh = ExtResource("11_rr")
surface_material_override/0 = ExtResource("3_mat")
