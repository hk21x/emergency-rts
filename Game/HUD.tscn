script = ExtResource("2_box")

; Everything drawn over the 3D view. Ignores the mouse as a whole; the minimap and the
; incident rows inside it opt back in, because a click meant for either must never also
; be read as an order out in the world.
[node name="World" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; The shift clock and what is outstanding, centred at the top -- where the eye returns
; to between orders.
; A PanelContainer since the UI kit's top bar arrived -- the strip is a *frame* now,
; and it builds its own row inside itself. Wider than the old pill cluster because it
; carries a headline as well as the readings, and pinned to both edges rather than
; centred on a fixed width, which is what the reference does.
; **Centred and sized to its own content**, not pinned to both edges. Full-width was
; the first cut and it was wrong twice over: it took most of the room above the city
; for four short numbers, and it ran straight through the call list and under the
; minimap. Both anchors at the middle with BOTH grow directions is what makes a
; PanelContainer shrink to fit.
[node name="StatusStrip" type="PanelContainer" parent="Root/World"]
anchor_left = 0.5
anchor_right = 0.5
offset_top = 16.0
grow_horizontal = 2
mouse_filter = 2
script = ExtResource("8_status")

; **The top-right corner**: the score, the fleet count, and the buttons that open the
; pause card and settings. Content-sized and grown leftward from the right margin, the
; same way the top strip is grown from its centre, so a long number pushes the cluster
; left instead of off the screen. Until this panel arrived the menu was reachable only
; by pressing P.
[node name="ScoreStrip" type="PanelContainer" parent="Root/World"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -300.0
offset_top = 16.0
offset_right = -22.0
grow_horizontal = 0
mouse_filter = 2
script = ExtResource("17_score")

; **The right-hand edge**, under the score. It sat top-left for most of its life, but
; when the dispatch rows moved into the left column there was no longer room for both --
; and hiding the radio log had just emptied this side of the screen. So the board took
; the space the log gave up. Narrower than it was (398 against 448) to keep clear of the
; central 40%, which belongs to the city and which the suite measures.
