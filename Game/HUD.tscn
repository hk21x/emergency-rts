; **Not a bar any more.** It was one opaque strip across the bottom holding four
; blocks in a row; the UI kit's reference floats them in the corners with the city
; visible between. This node stayed -- renaming it would move fourteen `$` paths in
; HUD.gd and thirty more in the suite -- but it is now a transparent full-rect layer
; that the bottom panels anchor themselves inside. No stylebox, no size of its own,
; and it stops the mouse nowhere.
[node name="Bar" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; Likewise: the row that laid four blocks out left-to-right is now a plain layer, and
; each block anchors itself into a corner.
[node name="Row" type="Control" parent="Root/Bar"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; The kit's unit-selection panel: a frame with its own 34px header bar built into the
; art, which is where the reference puts the unit's name.
; **Hidden at the user's request.** The readout said the unit's name, speed and what it
; was doing; the commands panel beside it already says which unit is selected by what it
; offers. Hidden rather than deleted because `HUD.gd:35` reaches it with `$` and the
; suite holds it as a fixture -- deleting the node crashes both, and the Portrait keeps
; updating happily out of sight.
[node name="PortraitBlock" type="PanelContainer" parent="Root/Bar/Row"]
visible = false
