[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

; A CanvasLayer cannot carry a theme, so everything hangs off one Control that can.
; Click-through: the panels below claim their own input.
; The district's own sounds: the city bed and the dispatch radio. Not a panel, but
; this is the always-present hand-authored scene and the one that already holds the
; references to the board and the director.
[node name="Soundscape" type="Node" parent="."]
script = ExtResource("14_sound")

; The interface's click and rollover. A sibling of the Soundscape rather than a helper
; called from nine places: it finds every button and every clickable control by watching
; `SceneTree.node_added`, which is the shape CLAUDE.md asks new systems to keep, and it
; covers the controls built at runtime that a call-site rule would have missed.
[node name="ClickSounds" type="Node" parent="."]
script = ExtResource("18_clicks")

; The tutorial's "press this next" glow. Idle in the district -- only the tutorial ever
; hands it a target -- so it costs a null check a frame everywhere else.
[node name="Spotlight" type="Node" parent="."]
script = ExtResource("19_spot")

[node name="Root" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
