; **The upper half of the left column**, which is where the reference puts its units.
; The roster inside is an HFlowContainer, so it wraps to whatever the width allows -- 180
; takes three chips a row, and 308px of height holds the seven-unit fixture with a little
; to spare. Its height is content-driven, so a much larger fleet grows it downward into
; the dispatch block below; the overlap invariant is what would report that.
[node name="RosterBlock" type="PanelContainer" parent="Root/Bar/Row"]
custom_minimum_size = Vector2(300, 0)
offset_left = 22.0
offset_top = 92.0
offset_right = 322.0
offset_bottom = 470.0
theme_type_variation = &"CardPanel"

[node name="Body" type="VBoxContainer" parent="Root/Bar/Row/RosterBlock"]

