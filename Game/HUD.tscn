offset_left = 22.0
offset_top = -186.0
offset_right = 136.0
offset_bottom = -160.0
grow_vertical = 0
mouse_filter = 0
theme_type_variation = &"PillPanel"

[node name="Caption" type="Label" parent="Root/World/ControlsToggle"]
