; Win/lose banner. Hidden until the mission ends.
[node name="Banner" type="Label" parent="Root/World"]
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -110.0
offset_right = 340.0
offset_bottom = -30.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
horizontal_alignment = 1
theme_type_variation = &"BannerLabel"

; The line under the banner at the end of a freeplay shift: score and tallies.
[node name="Debrief" type="Label" parent="Root/World"]
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -18.0
offset_right = 340.0
offset_bottom = 12.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

; The docked command bar. Opaque and mouse-stopping: it is the edge of the screen, and
; a click that lands on it is a click on the interface, not an order in the world.
[node name="Bar" type="PanelContainer" parent="Root"]
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -148.0
grow_horizontal = 2
grow_vertical = 0
theme_type_variation = &"BarPanel"

[node name="Row" type="HBoxContainer" parent="Root/Bar"]

[node name="PortraitBlock" type="PanelContainer" parent="Root/Bar/Row"]
custom_minimum_size = Vector2(250, 0)
theme_type_variation = &"CardPanel"

[node name="Portrait" type="VBoxContainer" parent="Root/Bar/Row/PortraitBlock"]
script = ExtResource("5_portrait")

[node name="RosterBlock" type="PanelContainer" parent="Root/Bar/Row"]
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"

[node name="Body" type="VBoxContainer" parent="Root/Bar/Row/RosterBlock"]

[node name="Heading" type="Label" parent="Root/Bar/Row/RosterBlock/Body"]
theme_type_variation = &"HeaderLabel"
text = "UNITS UNDER COMMAND"

[node name="Roster" type="HFlowContainer" parent="Root/Bar/Row/RosterBlock/Body"]
size_flags_vertical = 3
script = ExtResource("6_roster")

; Wide enough for the fattest selection -- seven verbs, on an officer or a patrol
; car -- in ONE row of tiles. Let them wrap and the PanelContainer grows, the bar
; grows with it, and whatever sits just above the bar is silently covered. That is
; the same trap the dispatch pills fell into, and it once ate the CONTROLS chip.
[node name="CommandBlock" type="PanelContainer" parent="Root/Bar/Row"]
custom_minimum_size = Vector2(460, 0)
theme_type_variation = &"CardPanel"

[node name="Body" type="VBoxContainer" parent="Root/Bar/Row/CommandBlock"]

[node name="Heading" type="Label" parent="Root/Bar/Row/CommandBlock/Body"]
theme_type_variation = &"HeaderLabel"
text = "COMMANDS"

[node name="CommandGrid" type="HFlowContainer" parent="Root/Bar/Row/CommandBlock/Body"]
size_flags_vertical = 3
script = ExtResource("7_commands")

; Wide enough for the roster laid out in two columns -- six types stacked in one
; made the bar 185px tall and swallowed the CONTROLS chip. The purse readout lives
; in the Heading below, updated by the Dispatch panel.
[node name="DispatchBlock" type="PanelContainer" parent="Root/Bar/Row"]
custom_minimum_size = Vector2(300, 0)
theme_type_variation = &"CardPanel"

[node name="Body" type="VBoxContainer" parent="Root/Bar/Row/DispatchBlock"]

[node name="Heading" type="Label" parent="Root/Bar/Row/DispatchBlock/Body"]
theme_type_variation = &"HeaderLabel"
text = "DISPATCH"

[node name="Dispatch" type="VBoxContainer" parent="Root/Bar/Row/DispatchBlock/Body"]
size_flags_vertical = 3
script = ExtResource("10_dispatch")

; The unit shop: portraits, prices and what each unit is for. Opened from the
; DISPATCH heading (or any empty row); game-side, so it does not pause. Before Menu
; in the tree so the pause card can still draw over it.
[node name="Shop" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("13_shop")

; The game's framing: the title card, the pause menu (P) and settings. Last child of
; Root so it draws over everything, including the bar. PROCESS_MODE_ALWAYS is what
; lets it run -- and hear the keyboard -- while it has the rest of the tree paused.
[node name="Menu" type="Control" parent="Root"]
process_mode = 3
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("12_menu")
