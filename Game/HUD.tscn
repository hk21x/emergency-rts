theme_type_variation = &"HeaderLabel"
text = "UNITS UNDER COMMAND"

[node name="Roster" type="VBoxContainer" parent="Root/Bar/Row/RosterBlock/Body"]
size_flags_vertical = 3
script = ExtResource("6_roster")

; Commands, bottom-centre. **Slimmer since August 2026, at the user's ask**: the tile came
; down 54 -> 48 and the block 560 -> 500 wide.
;
; The height is the part that has to be got right, and it is pinned to the *fattest*
; selection rather than to the common one. 500px takes nine 48px tiles a row, the fattest
; selection offers fourteen, so the grid wraps to two rows and the panel wants 141px. Pin
; it shorter than that and the block resizes as the selection changes -- which moves the
; view under the player and is exactly what "no panel moves with the selection" catches.
;
; **The offsets are bottom-anchored, so the height is the difference between them**, not
; the top one. -145..-22 reads like 145 and is 123, which is how this was first shipped
; wrong: the content minimum quietly won and the panel breathed with every selection.
; -172..-22 is 150, against a measured 141.
[node name="CommandBlock" type="PanelContainer" parent="Root/Bar/Row"]
custom_minimum_size = Vector2(500, 0)
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -240.0
offset_top = -172.0
offset_right = 260.0
offset_bottom = -22.0
grow_horizontal = 2
grow_vertical = 0
theme_type_variation = &"CommandGridPanel"

[node name="Body" type="VBoxContainer" parent="Root/Bar/Row/CommandBlock"]

[node name="Heading" type="Label" parent="Root/Bar/Row/CommandBlock/Body"]
theme_type_variation = &"HeaderLabel"
text = "COMMANDS"

[node name="CommandGrid" type="HFlowContainer" parent="Root/Bar/Row/CommandBlock/Body"]
size_flags_vertical = 3
script = ExtResource("7_commands")

; **Hidden at the user's request** (August 2026): the Patrol / Ambulance / ... row list is
; gone. What it did lives on in two places -- the purse moved up to the top bar, and
; sending a unit out moved into the roster above, where a unit still in the station shows
; as a dimmed chip you can click. `Station.dispatch()` had no other caller in the whole
; interface, so that move was not optional.
;
; Hidden rather than deleted, like PortraitBlock and RadioLog: `HUD.gd` reaches the panel
; inside with `$`, the suite holds the path, and the rows cost nothing to keep building
; out of sight. The offsets are the ones it last occupied.
[node name="DispatchBlock" type="PanelContainer" parent="Root/Bar/Row"]
visible = false
custom_minimum_size = Vector2(180, 0)
offset_left = 22.0
offset_top = 408.0
offset_right = 202.0
offset_bottom = 610.0
theme_type_variation = &"CardPanel"

[node name="Body" type="VBoxContainer" parent="Root/Bar/Row/DispatchBlock"]

[node name="Heading" type="Label" parent="Root/Bar/Row/DispatchBlock/Body"]
theme_type_variation = &"HeaderLabel"
text = "DISPATCH"

[node name="Dispatch" type="VBoxContainer" parent="Root/Bar/Row/DispatchBlock/Body"]
size_flags_vertical = 3
script = ExtResource("10_dispatch")

; The unit shop: portraits, prices and what each unit is for. Opened from the
; DISPATCH heading (or any empty row); game-side, so it does not pause. Before Menu
; in the tree so the pause card can still draw over it.
[node name="Shop" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("13_shop")

; The game's framing: the title card, the pause menu (Esc) and settings. Last child of
; Root so it draws over everything, including the bar. PROCESS_MODE_ALWAYS is what
; lets it run -- and hear the keyboard -- while it has the rest of the tree paused.
[node name="Menu" type="Control" parent="Root"]
process_mode = 3
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("12_menu")
