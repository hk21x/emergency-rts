[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

; A CanvasLayer cannot carry a theme, so everything hangs off one Control that can.
; Click-through: the panels below claim their own input.
; The district's own sounds: the city bed and the dispatch radio. Not a panel, but
; this is the always-present hand-authored scene and the one that already holds the
; references to the board and the director.
[node name="Soundscape" type="Node" parent="."]
script = ExtResource("14_sound")

[node name="Root" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("4_theme")

[node name="SelectionBox" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_box")

; Everything drawn over the 3D view. Ignores the mouse as a whole; the minimap and the
; incident rows inside it opt back in, because a click meant for either must never also
; be read as an order out in the world.
[node name="World" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; The shift clock and what is outstanding, centred at the top -- where the eye returns
; to between orders.
[node name="StatusStrip" type="HBoxContainer" parent="Root/World"]
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 16.0
offset_right = 300.0
offset_bottom = 54.0
grow_horizontal = 2
mouse_filter = 2
alignment = 1
script = ExtResource("8_status")

[node name="CallList" type="VBoxContainer" parent="Root/World"]
offset_left = 22.0
offset_top = 20.0
offset_right = 430.0
offset_bottom = 300.0
mouse_filter = 2
script = ExtResource("9_calls")

[node name="MinimapCard" type="PanelContainer" parent="Root/World"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -232.0
offset_top = 20.0
offset_right = -22.0
offset_bottom = 230.0
grow_horizontal = 0
mouse_filter = 2
theme_type_variation = &"CardPanel"

[node name="Minimap" type="Control" parent="Root/World/MinimapCard"]
script = ExtResource("3_minimap")

; The controls card, closed by default and opened from the chip below it (or F1).
; Sits just above the docked bar, in the corner the bar does not reach. The card
; builds its own rows -- keycap textures for the keys, matching chips for the rest.
[node name="HelpPanel" type="PanelContainer" parent="Root/World"]
visible = false
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 22.0
offset_top = -512.0
offset_right = 500.0
offset_bottom = -196.0
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"CardPanel"

[node name="Help" type="VBoxContainer" parent="Root/World/HelpPanel"]
mouse_filter = 2
script = ExtResource("11_controls")

; The visible way into the card -- F1 is a shortcut, not a secret.
[node name="RadioLog" type="VBoxContainer" parent="Root/World"]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 22.0
offset_top = -294.0
offset_right = 460.0
offset_bottom = -196.0
grow_vertical = 0
mouse_filter = 2
