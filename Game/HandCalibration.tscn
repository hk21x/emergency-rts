; Held-prop calibration harness. Needs a window -- the whole job is looking:
;   godot --path . res://Game/HandCalibration.tscn
;
; Lighting and ground are lifted from AnimationViewer.tscn, which solved the same
; problem: a character has to be lit from two sides to read as a shape, and the floor
; has to be a colour the uniform is not.

[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Game/HandCalibration.gd" id="1_script"]
[ext_resource type="Environment" path="res://Assets/Synty/PolygonStarter/Materials/WorldEnvironmentLighting.tres" id="2_env"]
[ext_resource type="ArrayMesh" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonPrototype_Buildings_Floor_5x5_01P.res" id="3_floor"]
[ext_resource type="Material" path="res://Assets/Synty/PolygonStarter/Materials/PolygonStarter_Mat_04_mat.tres" id="4_mat"]

[node name="HandCalibration" type="Node3D"]
script = ExtResource("1_script")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")

[node name="KeyLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.57357645, 0.6087486, -0.54811966, 0, 0.66913056, 0.74314487, 0.819152, 0.4262504, -0.38379753, 0, 0, 0)
light_color = Color(1, 0.9569, 0.8392, 1)
shadow_enabled = true
shadow_bias = 0.05

; A second key from the opposite side rather than a dim fill: a pistol against a dark
; glove is all silhouette, and one light leaves half of it unreadable.
[node name="FillLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.5, 0, 0.86602545, 0.4330127, 0.8660254, -0.25, -0.75, 0.5, 0.4330127, 0, 0, 0)
light_color = Color(0.8015, 0.8686, 1, 1)
light_energy = 0.55

[node name="Ground" type="MeshInstance3D" parent="."]
transform = Transform3D(3, 0, 0, 0, 1, 0, 0, 0, 3, 7.5, 0, -7.5)
mesh = ExtResource("3_floor")
surface_material_override/0 = ExtResource("4_mat")

; Near plane pulled right in: the camera sits centimetres from the hand at full zoom,
; and the default 0.05 clips the prop away exactly when you are trying to look at it.
[node name="Camera" type="Camera3D" parent="."]
near = 0.01
fov = 45.0

[node name="UI" type="CanvasLayer" parent="."]

[node name="Head" type="Label" parent="UI"]
offset_left = 16.0
offset_top = 12.0
offset_right = 1200.0
offset_bottom = 70.0
theme_override_font_sizes/font_size = 18

; The live numbers, kept apart from the heading so the eye can find them without
; re-reading the character's name every time.
[node name="Numbers" type="Label" parent="UI"]
offset_left = 16.0
offset_top = 74.0
offset_right = 1200.0
offset_bottom = 100.0
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(0.65, 0.9, 1, 1)

[node name="Keys" type="Label" parent="UI"]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -96.0
offset_right = 1200.0
offset_bottom = -12.0
grow_vertical = 0
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.75, 0.78, 0.82, 1)
