; The missing child's body: an ordinary civilian scene with the character scaled to
; 0.7 -- no child-sized mesh exists in any pack, and at RTS distance small is young.
; Same collision arrangement as every civilian (crowd layer 128, solid only to the
; static world), so it is unpickable and unselectable by construction. The capsule is
; shrunk to match the mesh so a searcher can stand right beside them.

[gd_scene format=3]

[ext_resource type="Script" path="res://Game/Units/ChildWanderer.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://Game/Characters/Male_Hoodie.tscn" id="2_body"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_small"]
radius = 0.24
height = 1.3

[node name="Child" type="CharacterBody3D"]
collision_layer = 128
collision_mask = 1
script = ExtResource("1_script")
display_name = "Child"

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.65, 0)
shape = SubResource("CapsuleShape3D_small")

[node name="NavigationAgent" type="NavigationAgent3D" parent="."]
path_desired_distance = 0.5
target_desired_distance = 0.7
navigation_layers = 2

; The usual 180-degree yaw (Synty faces +Z, Godot forward is -Z), times the 0.7 that
; makes an adult rig read as a child.
[node name="Character" parent="." instance=ExtResource("2_body")]
transform = Transform3D(-0.7, 0, 0, 0, 0.7, 0, 0, 0, -0.7, 0, 0, 0)
