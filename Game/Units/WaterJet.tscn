; The stream out of a hose or an extinguisher, aimed at whatever is being fought.
;
; Built here rather than found in a pack: the Particle_FX pack ships no water. What it
; does ship is rain -- short ribbon streaks on a vertex-coloured unshaded material -- and
; a hose is rain with somewhere to be. So the material is the pack's Rain_01 verbatim
; (vendor files are never edited) and everything above it is ours: a point nozzle firing
; along local -Z, a narrow spread, and enough gravity to make the stream droop like water
; rather than fly like a laser.
;
; Aimed by Person.spray_at(), which points -Z at the target every frame. `local_coords`
; stays off so the droplets are left behind in world space -- a person who turns while
; spraying whips the nozzle round, not the water already in the air.

[gd_scene load_steps=4 format=3]

[ext_resource type="Material" uid="uid://g02vx5nq1e4o" path="res://Assets/Particle_FX/Materials/FX/Rain_01.tres" id="1_water"]

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_jet"]
lifetime_randomness = 0.25
particle_flag_align_y = true
direction = Vector3(0, 0, -1)
spread = 9.0
initial_velocity_min = 10.0
initial_velocity_max = 13.0
gravity = Vector3(0, -7, 0)
scale_min = 0.9
scale_max = 1.8
color = Color(0.72, 0.87, 1, 0.7)

; Tapered at both ends so a droplet reads as a streak with a head, not a stick. The peak
; is the fattest point of the streak: at 0.075 the jet read as a fine mist rather than a
; hose, so it is more than double that now.
[sub_resource type="Curve" id="Curve_taper"]
_data = [Vector2(0, 0), 0.0, 0.0, 0, 0, Vector2(0.3, 0.17), 0.0, 0.0, 0, 0, Vector2(1, 0), 0.0, 0.0, 0, 0]
point_count = 3

[sub_resource type="RibbonTrailMesh" id="RibbonTrailMesh_drop"]
material = ExtResource("1_water")
size = 0.8
sections = 3
section_length = 0.15
curve = SubResource("Curve_taper")

; Ships not emitting. Person turns it on for as long as water is actually being
; delivered and no longer -- see Person.spray_at.
[node name="WaterJet" type="GPUParticles3D"]
cast_shadow = 0
emitting = false
amount = 120
lifetime = 0.55
visibility_aabb = AABB(-8, -8, -8, 16, 16, 16)
process_material = SubResource("ParticleProcessMaterial_jet")
draw_pass_1 = SubResource("RibbonTrailMesh_drop")
