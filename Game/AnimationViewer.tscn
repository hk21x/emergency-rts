; Standalone animation viewer. Run with:
;   godot --path . res://Game/AnimationViewer.tscn

[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://Game/AnimationViewer.gd" id="1_script"]
[ext_resource type="Environment" path="res://Assets/Synty/PolygonStarter/Materials/WorldEnvironmentLighting.tres" id="2_env"]
[ext_resource type="ArrayMesh" path="res://Assets/Synty/PolygonStarter/Models/extracted/SM_PolygonPrototype_Buildings_Floor_5x5_01P.res" id="3_floor"]
; Mat_04 (orange) rather than Mat_01 (blue): the character is blue, and blue-on-blue
; makes the silhouette hard to read, which is the whole point of this scene.
[ext_resource type="Material" path="res://Assets/Synty/PolygonStarter/Materials/PolygonStarter_Mat_04_mat.tres" id="4_mat"]
[ext_resource type="PackedScene" path="res://Game/Characters/Character.tscn" id="5_character"]

[node name="AnimationViewer" type="Node3D"]
script = ExtResource("1_script")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
