; Tile has a corner origin covering x[-5,0] z[0,5]; scaled 3x and shifted so the
; 15x15 slab is centred on the character. Its top surface stays at y=0.
[node name="Ground" type="MeshInstance3D" parent="."]
transform = Transform3D(3, 0, 0, 0, 1, 0, 0, 0, 3, 7.5, 0, -7.5)
mesh = ExtResource("3_floor")
surface_material_override/0 = ExtResource("4_mat")

