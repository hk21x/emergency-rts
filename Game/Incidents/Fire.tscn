; A fire. Collision layer 8: pickable by the selection raycast, but outside the
; vehicle (mask 3) and person (mask 1) masks, so nobody collides with it, and outside
; the navigation bake (mask 1), so it never carves a hole in the paths.

;
;
; One large fire in the middle, and nothing else. There was a flat orange cone under
; these particles until August 2026, there to be the readable shape from the RTS camera
; while the particles sold it up close. Once the particle pack's fire went in, the cone
; was a lozenge sitting inside a fire that no longer needed it. Both plume and smoke are
; driven from Fire.intensity by Fire.gd.

[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Game/Incidents/Fire.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://Assets/Particle_FX/Prefabs/FX/FX_Fire_Large_01.tscn" id="3_fire"]
[ext_resource type="PackedScene" path="res://Assets/Particle_FX/Prefabs/FX/FX_Smoke_01.tscn" id="4_smoke"]

[sub_resource type="SphereShape3D" id="SphereShape3D_pick"]
radius = 1.6

[node name="Fire" type="StaticBody3D"]
collision_layer = 8
collision_mask = 0
script = ExtResource("1_script")
display_name = "Fire"

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
shape = SubResource("SphereShape3D_pick")

; Unit cone centred on its origin; Fire.gd scales this and lifts it so the base stays
; on the ground as the fire grows.
[node name="Flames" parent="." instance=ExtResource("3_fire")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.25, 0)

[node name="Smoke" parent="." instance=ExtResource("4_smoke")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
