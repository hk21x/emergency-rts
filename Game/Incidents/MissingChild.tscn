shape = SubResource("BoxShape3D_pick")

[node name="Marker" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
material_override = SubResource("StandardMaterial3D_marker")
cast_shadow = 0
mesh = SubResource("TorusMesh_marker")

; The usual 180-degree yaw -- Synty faces +Z, Godot forward is -Z.
[node name="Character" parent="." instance=ExtResource("2_character")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
