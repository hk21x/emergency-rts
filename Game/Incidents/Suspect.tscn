; A disturbance: somebody on their feet giving trouble, standing where Casualty lies.
; Same collision arrangement -- pickable on layer 8, solid to nothing -- with the box
; raised to head height because the pick ray has to hit a standing figure. The clip is
; played by Suspect.gd: rowdy while live, quiet once detained.

[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Game/Incidents/Suspect.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://Game/Characters/Character.tscn" id="2_character"]

[sub_resource type="BoxShape3D" id="BoxShape3D_pick"]
size = Vector3(1.4, 1.9, 1.4)

[sub_resource type="TorusMesh" id="TorusMesh_marker"]
inner_radius = 1.1
outer_radius = 1.28
rings = 32
ring_segments = 6

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_marker"]
transparency = 1
shading_mode = 0
albedo_color = Color(0.35, 0.55, 1, 0.8)

[node name="Suspect" type="StaticBody3D"]
collision_layer = 8
collision_mask = 0
script = ExtResource("1_script")
display_name = "Disturbance"

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.95, 0)
shape = SubResource("BoxShape3D_pick")

; Police-blue ring, so the job is findable from the RTS camera the way a casualty's
; red one is.
[node name="Marker" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
material_override = SubResource("StandardMaterial3D_marker")
cast_shadow = 0
mesh = SubResource("TorusMesh_marker")

; Yawed 180 like Person.tscn and Paramedic.tscn: the character mesh faces +Z while
; Godot's forward is -Z, and the whole project steers with atan2(x, z) + PI on the
; assumption this yaw is here. Without it the suspect walks backwards -- which is
; exactly how the first one shipped.
[node name="Character" parent="." instance=ExtResource("2_character")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
